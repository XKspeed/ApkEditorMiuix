<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 回编译输出到公共目录（Android 11+ 需用户在系统设置授予"所有文件访问"） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- enableOnBackInvokedCallback 必须为 true：
         预测式返回（predictive back）依赖它把 NavigationEventDispatcher 挂到 view 树上，
         App.kt 的 NavigationBackHandler 会从 LocalNavigationEventDispatcherOwner 取该
         dispatcher。若缺失，取值得到 null，NavigationEventHandler 会直接抛
         IllegalStateException（No NavigationEventDispatcher was provided），应用启动即崩。 -->
    <!-- largeHeap 必须开：本工具要整块解析 resources.arsc（MiuiSystemUI 级别的表
         解压后数百 MB）。默认堆上限 256MB 不够，TableBlock.load 中途 OOM
         （表现为打开 arsc 闪退）。日志实锤：
         "Failed to allocate a 32 byte allocation ... target footprint 268435456"。 -->
    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApkEditorMiuix"
        tools:ignore="UnusedAttribute">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃汇报页：主进程崩溃后拉起，显示错误摘要 + 分享按钮。
             separateProcess 不可用（Android 已禁止为同一 app 的 activity 声明独立进程），
             因此必须用传统 View 尽量少依赖崩溃前的状态。 -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 分享本地输出 APK 用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
